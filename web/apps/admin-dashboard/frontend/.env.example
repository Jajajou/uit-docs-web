# ============================================================================
# Admin Dashboard Frontend â€” environment variables
# ----------------------------------------------------------------------------
# Used by Vite at build time. Copy this file to `.env.local` for local dev,
# or paste the values into the Vercel project's Environment Variables
# (Production / Preview / Development) for deployments.
# ============================================================================

# ----------------------------------------------------------------------------
# API base URL
# ----------------------------------------------------------------------------
# When unset, src/shared/api/client.ts falls back to `/api`, which works
# perfectly on Vercel because vercel.json rewrites `/api/(.*)` onto the
# Render backend (no browser CORS preflight). Override only when running
# the frontend against a backend on a different origin (e.g. local docker
# compose where the backend is on http://127.0.0.1:8001/api).
#
# Production (Vercel + Render):    leave UNSET (use `/api` proxy)
# Local against docker compose:    http://127.0.0.1:8001/api
# Standalone preview elsewhere:    https://uit-docs-web.onrender.com/api
VITE_API_BASE_URL=

# ----------------------------------------------------------------------------
# Mock toggle (e2e + Storybook only)
# ----------------------------------------------------------------------------
# When `true`, axios is replaced by a deterministic mock adapter so
# frontend e2e tests can run without a live backend. Production must
# leave this UNSET or `false`.
VITE_ENABLE_MOCKS=

# ----------------------------------------------------------------------------
# Direct LangGraph stream (advanced)
# ----------------------------------------------------------------------------
# Optional override that lets the frontend stream from LangGraph directly
# instead of going through the admin backend BFF. Leave UNSET for the
# default (BFF) path used by Vercel + Render.
VITE_LANGGRAPH_API_URL=
VITE_LANGGRAPH_ASSISTANT_ID=
