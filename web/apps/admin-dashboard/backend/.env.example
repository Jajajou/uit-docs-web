# ============================================================================
# Admin Dashboard Backend — environment variables
# ----------------------------------------------------------------------------
# Used by the FastAPI app at api.main:app (and the hardening shell at
# app.main:app). Render injects PORT automatically; local docker uses 8001.
# Copy this file to `.env` for local dev, or paste the values into the
# Render dashboard for staging/production.
# ============================================================================

# ----------------------------------------------------------------------------
# API server
# ----------------------------------------------------------------------------
# API_HOST   — interface to bind. Leave 0.0.0.0 for containers / Render.
# API_PORT   — local fallback only. On Render, $PORT is injected and the
#              Dockerfile CMD honours it.
# ENV        — one of `production`, `staging`, `dev`, `test`. Used by the
#              hardening shell to gate cookie hardening (R20.3).
API_HOST=0.0.0.0
API_PORT=8001
ENV=production

# ----------------------------------------------------------------------------
# Database (Render: paste the Neon Postgres pooled connection string)
# ----------------------------------------------------------------------------
# WORKSPACE_DATABASE_URL — SQLAlchemy URL. For Neon use:
#   postgresql+psycopg2://USER:PASS@HOST/DB?sslmode=require
# WORKSPACE_AUTO_SEED    — seed contract fixtures on startup. Keep `true`
#                          for staging/demo, `false` for prod once seeded.
# DATABASE_URL           — Render convention. The app reads
#                          WORKSPACE_DATABASE_URL; set both to the same value
#                          on Render so other tools (alembic helpers etc.)
#                          can use either name.
WORKSPACE_DATABASE_URL=postgresql+psycopg2://admin_dashboard_app:change-me-admin-dashboard-password@localhost:5433/admin_dashboard
DATABASE_URL=postgresql+psycopg2://admin_dashboard_app:change-me-admin-dashboard-password@localhost:5433/admin_dashboard
WORKSPACE_AUTO_SEED=true

# ----------------------------------------------------------------------------
# LightRAG upstream (private + public projects)
# ----------------------------------------------------------------------------
LIGHTRAG_URL=http://lightrag_uit:9621
LIGHTRAG_USERNAME=admin
LIGHTRAG_PASSWORD=change-me-lightrag-password
LIGHTRAG_API_KEY=
LIGHTRAG_PUBLIC_URL=
LIGHTRAG_PUBLIC_USERNAME=admin
LIGHTRAG_PUBLIC_PASSWORD=change-me-lightrag-password

# ----------------------------------------------------------------------------
# LangGraph upstream
# ----------------------------------------------------------------------------
# LANGGRAPH_URL          — used by api.config.settings (legacy path).
# LANGGRAPH_UPSTREAM_URL — used by app.core.settings (new hardening shell,
#                          required when running app.main:app).
LANGGRAPH_URL=http://localhost:2024
LANGGRAPH_UPSTREAM_URL=http://localhost:2024
LANGGRAPH_API_KEY=
LANGGRAPH_PUBLIC_URL=
LANGGRAPH_PUBLIC_API_KEY=
LANGGRAPH_INTERNAL_ASSISTANT_ID=5bbc8364-e383-5087-8a2f-b6d27677f7a1
LANGGRAPH_PUBLIC_ASSISTANT_ID=retrieval
LANGGRAPH_TIMEOUT_SECONDS=180

# ----------------------------------------------------------------------------
# File upload (Render filesystem is ephemeral — default to /tmp)
# ----------------------------------------------------------------------------
UPLOAD_DIR=/tmp/uploads
UPLOAD_STAGING_DIR=/tmp/uploads/staging
MAX_FILE_SIZE=52428800

# ----------------------------------------------------------------------------
# CORS / Trusted hosts
# ----------------------------------------------------------------------------
# CORS_ORIGINS         — used by api.main (legacy entrypoint).
# CORS_ALLOWED_ORIGINS — used by app.main (hardening shell). When unset, the
#                        hardening shell denies every cross-origin request.
# TRUSTED_HOSTS        — used by both entrypoints. When the hardening shell
#                        sees an empty value it returns HTTP 400 for every
#                        request (deny-all, R20.7).
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TRUSTED_HOSTS=api.gm.uit.edu.vn,127.0.0.1,localhost
FORCE_HTTPS_REDIRECT=true

# ----------------------------------------------------------------------------
# Cookies / sessions / rate limit
# ----------------------------------------------------------------------------
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=.gm.uit.edu.vn
EXPOSE_ERROR_DETAILS=false
TEST_MODE=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# JWT_SECRET — used when ENABLE_DEMO_AUTH=true to sign demo session tokens
# (production should rely on Google SSO and leave this empty).
JWT_SECRET=

# ----------------------------------------------------------------------------
# Google SSO (production sign-in path)
# ----------------------------------------------------------------------------
SSO_PROVIDER_MODE=external
SSO_PROVIDER_NAME=Google Workspace UIT
SSO_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
SSO_TOKEN_URL=https://oauth2.googleapis.com/token
SSO_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPE=openid email profile
SSO_HOSTED_DOMAIN=gm.uit.edu.vn
SSO_CALLBACK_BASE_URL=https://api.gm.uit.edu.vn
SSO_FRONTEND_BASE_URL=https://app.gm.uit.edu.vn
SSO_ROLE_CLAIM=role
SSO_GROUP_CLAIM=groups
SSO_EMAIL_CLAIM=email
SSO_GROUP_ROLE_MAP=
SSO_ROLE_HINT_MAP=teacher:teacher,admin:admin
ENABLE_DEMO_AUTH=false

# Optional: align with Google's variable names if your tooling uses them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Live ingestion gateway
# ----------------------------------------------------------------------------
# When false (default) uploads/reindex stays on the contract/mock path.
# Flip to true once LightRAG + LangGraph reach steady state in staging.
LIVE_INGESTION_MODE=false
