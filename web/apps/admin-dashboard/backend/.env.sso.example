# Switch the /web backend from the local SSO emulator to a real institutional provider.
# Copy the needed values into your local backend .env when the real provider metadata is available.

SSO_PROVIDER_MODE=external
SSO_PROVIDER_NAME=UIT Institutional SSO

# Provider authorize endpoint for the browser redirect started at GET /api/auth/sso/start
SSO_AUTHORIZE_URL=https://sso.example.edu/oauth2/authorize

# Registered client id for the /web backend integration
SSO_CLIENT_ID=uit-web-admin-dashboard
SSO_CLIENT_SECRET=replace-me

# Standard OIDC-like scope string. Add provider-specific scopes only if required.
SSO_SCOPE=openid profile email groups

# Backend origin that serves /api/auth/sso/callback
# Example:
#   http://127.0.0.1:8001
#   https://admin-dashboard.uit.edu.vn
SSO_CALLBACK_BASE_URL=http://127.0.0.1:8001
SSO_FRONTEND_BASE_URL=http://127.0.0.1:3000
SSO_HOSTED_DOMAIN=gm.uit.edu.vn

# Claim names returned by the provider. Keep defaults if the provider is OIDC-aligned.
SSO_ROLE_CLAIM=role
SSO_GROUP_CLAIM=groups
SSO_EMAIL_CLAIM=email

# Optional group-to-role mapping for internal entitlement resolution.
# Format: provider_group:internal_role,provider_group:internal_role
SSO_GROUP_ROLE_MAP=uit-teachers:teacher,uit-admins:admin

# Optional direct role-hint mapping if the provider returns a role-like claim.
# Format: provider_role_hint:internal_role,provider_role_hint:internal_role
SSO_ROLE_HINT_MAP=teacher:teacher,admin:admin

# Recommended runtime hardening once the app is behind HTTPS and real domains.
TRUSTED_HOSTS=api.gm.uit.edu.vn
FORCE_HTTPS_REDIRECT=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=.gm.uit.edu.vn
